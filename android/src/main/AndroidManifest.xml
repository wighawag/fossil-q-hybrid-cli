<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 12+ (API 31+): explicit connect/scan permissions. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Legacy (API <= 30): classic Bluetooth + location for BLE scans. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- WP-TRACKER: ACCESS_FINE_LOCATION is now needed on ALL API levels (the FusedLocationProvider
         GPS fix for waypoint logging), so the legacy maxSdkVersion=30 cap (it was only for BLE
         scans on API <= 30) is removed. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- WP-TRACKER: ACCESS_COARSE_LOCATION is now uncapped (was maxSdkVersion=30, BLE-scan-only). On
         API 31+ a runtime ACCESS_FINE_LOCATION request must be paired with ACCESS_COARSE_LOCATION
         so the system shows the Precise/Approximate toggle correctly. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- WP3: foreground service keeping the watch link alive in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- WP-TRACKER: the GPS-waypoint tracker captures a fix when a TRACKER-role gesture / a
         "Log GPS waypoint" button fires. Logging happens while the phone is pocketed under the
         foreground service, so the FGS gains the `location` type and the runtime location perms
         below are required. ACCESS_FINE_LOCATION here (NOT maxSdkVersion-capped, unlike the legacy
         BLE-scan entry) is the runtime grant the FusedLocationProvider needs on all API levels. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- WP-TRACKER: ACCESS_BACKGROUND_LOCATION lets a tracker gesture log a fix while the app is in
         the background (phone pocketed). PLAY-SENSITIVE: Google Play requires a prominent
         disclosure + a privacy-policy justification at submission ("log GPS waypoints on a watch
         button press while the app runs in the background as a foreground service"). Requested at
         runtime AFTER foreground location is granted (the two-step background-location flow). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- WP3: restart the service + reconnect after reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- WP3: ask the user to exempt us from Doze so the background GATT link survives. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- WP3: CompanionDeviceManager event-driven presence observation (API 31+). -->
    <uses-permission
        android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE"
        tools:targetApi="31" />
    <!-- WP3: show the persistent foreground-service notification on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- WP-TRACKER (§4): vibrate the PHONE during the loud "find my phone" ring (a TRACKER-role long
         gesture / a RING_PHONE button). The watch buzz-back goes over BLE and needs no permission;
         this is for the phone-side Vibrator in SystemPhoneRinger. A normal (non-runtime) permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- WP13: read the user's calendar to mirror upcoming events into the watch's calendar alarm
         slots (16..31). A normal runtime permission (requested via the permissions API from
         Setup); the read is app-only (CalendarContract.Instances) — no wire bytes change. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- WP16c: package visibility for the installed-app picker (Notifications screen).
         Android 11+ (API 30+) filters PackageManager queries to your visible set unless you
         declare what you need to see. This <queries> entry surfaces apps that have a LAUNCHER
         activity (user-facing apps that post notifications) so queryIntentActivities(LAUNCHER)
         returns the full list. No runtime permission, no Play-sensitive QUERY_ALL_PACKAGES.
         If we later need NON-launchable packages too, switch to OPTION B: add the
         <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/> permission
         (note: Play-Store-sensitive, requires a declared justification at submission). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <!-- WP3: CompanionDeviceManager (event-driven reconnect, no continuous scan). -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <application
        android:name=".FossilQApplication"
        android:label="Fossil Q"
        android:theme="@style/Theme.FossilQ">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WP3: owns the FossilController/transport for the session. -->
        <service
            android:name=".WatchConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!-- WP3: CompanionDeviceManager presence callbacks (API 31+). The system binds
             this with BIND_COMPANION_DEVICE_SERVICE and wakes it when the associated
             watch appears — no scanning on our side. -->
        <service
            android:name=".WatchPresenceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE"
            tools:targetApi="31">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!-- WP11: notification listener — the OS binds this with BIND_NOTIFICATION_LISTENER_SERVICE
             after the user grants Notification Access (Settings, deep-linked from Setup). On each
             posted notification it matches the package against the active watch's per-app rule and
             (if matched) plays it on the watch (play-only-by-package; vibe+hands live in the
             already-uploaded NOTIFICATION_FILTER). exported is implied true by the intent-filter. -->
        <service
            android:name=".notifications.FossilNotificationListenerService"
            android:exported="true"
            android:label="Fossil Q notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- WP15: share exported log file via a content:// URI (export-to-file). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WP3: reboot survival — re-arm presence + restart the service. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
